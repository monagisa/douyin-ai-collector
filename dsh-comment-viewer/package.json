{
  "name": "dsh-comment-viewer",
  "version": "0.2.7",
  "description": "在 DeepSeek Harness Web 侧边栏里直接查看抖音评论词云（交互词云 + 评论表），数据来自本地导出的 douyin-comments-*.json",
  "type": "module",
  "license": "MIT",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "app",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
